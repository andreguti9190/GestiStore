# Django / acceso público
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
PUBLIC_BASE_URL=

# Producción en Vercel (Neon inyecta DATABASE_URL y Blob inyecta BLOB_STORE_ID)
DATABASE_URL=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
EMAIL_NOTICES_BACKGROUND=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600

# Correo
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Mercado Pago Checkout Pro (usar credenciales de prueba durante el desarrollo)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MODE=test

# Chatbot de ayuda (guardar la clave solamente en .env, nunca en JavaScript)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_TIMEOUT=25
OPENAI_ASSISTANT_RATE_LIMIT=12
OPENAI_ASSISTANT_RATE_WINDOW=300
OPENAI_INCLUDE_STORE_CONTEXT=true

# Opcional: respaldo de geocodificacion cuando Georef no devuelve coordenadas
ESRI_GEOCODE_URL=https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/findAddressCandidates
